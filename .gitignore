node_modules/
dist/
dist-ssr/

# Environment files
.env
.env.*
*.local

# npm / Yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------
# .NET build output
# ------------------------------
**/bin/
**/obj/

# ASP.NET generated files
StoreSalesInventory.Server/wwwroot/

